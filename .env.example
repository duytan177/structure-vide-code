# ─────────────────────────────────────────────────────────────
# VIDE-CODER — Secrets cho MCP servers (.mcp.json / .cursor/mcp.json)
#
# Cách dùng:
#   1. cp .env.example .env
#   2. Điền giá trị thật vào .env  (KHÔNG commit — .env đã nằm trong .gitignore)
#   3. Nạp env trước khi mở agent, ví dụ:  set -a; source .env; set +a
#
# .mcp.json đọc các biến này qua cú pháp ${VAR}. Bỏ trống server nào
# không dùng → server đó có thể không khởi động (bỏ qua nếu không cần).
# ─────────────────────────────────────────────────────────────

# GitHub MCP — Personal Access Token (repo scope). Tạo tại github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Figma MCP — API key (design-to-code). Tạo tại figma.com/developers
FIGMA_API_KEY=

# Magic / 21st.dev MCP — API key. Lấy tại 21st.dev
TWENTYFIRST_API_KEY=

# Postgres MCP — connection string. Nếu bỏ trống dùng default localhost trong .mcp.json
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/dbname
POSTGRES_CONNECTION_STRING=
