# ─────────────────────────────────────────────────────────────
# VIDE-CODER — Secrets for MCP servers (.mcp.json / .cursor/mcp.json)
#
# Usage:
#   1. cp .env.example .env
#   2. Fill in real values in .env  (DO NOT commit — .env is already in .gitignore)
#   3. Load the env before opening the agent, e.g.:  set -a; source .env; set +a
#
# .mcp.json reads these variables via the ${VAR} syntax. Leave any server you
# don't use blank → that server may not start (ignore if you don't need it).
# ─────────────────────────────────────────────────────────────

# GitHub MCP — Personal Access Token (repo scope). Create at github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Figma MCP — API key (design-to-code). Create at figma.com/developers
FIGMA_API_KEY=

# Magic / 21st.dev MCP — API key. Get it at 21st.dev
TWENTYFIRST_API_KEY=

# Postgres MCP — connection string. If left blank, uses the default localhost in .mcp.json
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/dbname
POSTGRES_CONNECTION_STRING=
