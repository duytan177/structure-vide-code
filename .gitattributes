# Chuẩn hóa line-ending & phân loại file
* text=auto eol=lf

*.sh    text eol=lf
*.md    text
*.json  text
*.yml   text
*.yaml  text

# Script luôn LF (tránh lỗi shebang trên Windows checkout)
.githooks/*   text eol=lf
.agent/scripts/*.sh   text eol=lf

# Binary
*.png binary
*.jpg binary
*.xlsx binary
*.pdf binary
