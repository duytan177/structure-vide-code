# Normalize line endings & classify files
* text=auto eol=lf

*.sh    text eol=lf
*.md    text
*.json  text
*.yml   text
*.yaml  text

# Scripts always LF (avoid shebang errors on Windows checkout)
.githooks/*   text eol=lf
.agent/scripts/*.sh   text eol=lf

# Binary
*.png binary
*.jpg binary
*.xlsx binary
*.pdf binary
