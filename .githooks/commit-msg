#!/usr/bin/env bash
# Ép Conventional Commits + Jira ID theo rule 03-git-jira-workflow.md
# Định dạng: <type>(<scope>): PROJECT-XXX - <summary>

msg_file="$1"
first_line="$(head -n1 "$msg_file")"

# Bỏ qua merge/revert commit tự động
case "$first_line" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|test|chore|perf|ci|build)(\([a-z0-9._-]+\))?: [A-Z]+-[0-9]+ - .+'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "❌ Commit message không đúng chuẩn."
  echo "   Yêu cầu: <type>(<scope>): PROJECT-XXX - <summary>"
  echo "   Ví dụ  : feat(auth): PROJECT-102 - Implement JWT refresh rotation"
  echo "   Types  : feat fix docs style refactor test chore perf ci build"
  echo "   Bạn viết: $first_line"
  exit 1
fi
exit 0
