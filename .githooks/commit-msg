#!/usr/bin/env bash
# Enforce Conventional Commits + Jira ID per rule 03-git-jira-workflow.md
# Format: <type>(<scope>): PROJECT-XXX - <summary>

msg_file="$1"
first_line="$(head -n1 "$msg_file")"

# Skip automatic merge/revert commits
case "$first_line" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|test|chore|perf|ci|build)(\([a-z0-9._-]+\))?: [A-Z]+-[0-9]+ - .+'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "❌ Commit message does not follow the standard."
  echo "   Required: <type>(<scope>): PROJECT-XXX - <summary>"
  echo "   Example : feat(auth): PROJECT-102 - Implement JWT refresh rotation"
  echo "   Types   : feat fix docs style refactor test chore perf ci build"
  echo "   You wrote: $first_line"
  exit 1
fi
exit 0
