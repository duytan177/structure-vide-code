#!/usr/bin/env bash
# Bước 8 (Self Validation) tối thiểu, chạy local trước commit.
# Tự phát hiện toolchain — không fail nếu chưa cài (chỉ cảnh báo), fail khi tool có mà lỗi.
set -u

fail=0

if [ -f package.json ]; then
  if command -v npm >/dev/null 2>&1; then
    if npm run | grep -q " lint"; then npm run lint --if-present || fail=1; fi
    if npm run | grep -q " typecheck"; then npm run typecheck --if-present || fail=1; fi
  fi
fi

# Chặn secret/hardcoded credential thô sơ trong file staged
staged="$(git diff --cached --name-only --diff-filter=ACM)"
if [ -n "$staged" ]; then
  if printf '%s\n' "$staged" | xargs -r grep -nEI '(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|password\s*=\s*["'"'"'][^"'"'"']{6,})' 2>/dev/null; then
    echo "❌ Phát hiện khả năng lộ secret/credential trong file staged. Vui lòng gỡ trước khi commit."
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "❌ pre-commit thất bại. Sửa lỗi rồi commit lại."
  exit 1
fi
exit 0
